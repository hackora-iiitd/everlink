# Neo4j Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_local_password_here
NEO4J_DATABASE=neo4j

# Backend
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0
DEBUG=false

# Frontend
VITE_API_URL=http://localhost:8000

# Optional: Gemini API (leave empty to disable)
GEMINI_API_KEY=

# Optional: LinkedIn OAuth (leave empty to disable)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:5173/auth/linkedin/callback

# Frontend auth (see docs/AUTH.md)
VITE_DEMO_MODE=true
VITE_API_URL=
